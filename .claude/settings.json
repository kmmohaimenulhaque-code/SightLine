{
  "extraKnownMarketplaces": {
    "blender-agent-skills": {
      "source": {
        "source": "github",
        "repo": "EL4CTEO/blender-skills"
      }
    }
  },
  "enabledPlugins": {
    "blender-agent-skills@blender-agent-skills": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}